JWT_SECRET_KEY=changeme_generate_with_openssl_rand_hex_32

GARMIN_CREDENTIAL_KEY=changeme_generate_fernet_key

# Dev local : SQLite
DATABASE_URL=sqlite:///./garmin.db
# Prod : PostgreSQL (injecté automatiquement par docker-compose.prod.yml)
# DATABASE_URL=postgresql://garmin:MOT_DE_PASSE@postgres:5432/garmin

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

HOST=0.0.0.0
PORT=8000

# Lancer le scheduler dans ce process (false sur les workers secondaires)
RUN_SCHEDULER=true
SYNC_INTERVAL_MINUTES=60
INITIAL_SYNC_DAYS=90

# Ouvrir ou fermer les inscriptions sur cette instance
ALLOW_REGISTRATION=true

# URL publique du frontend, utilisée dans les liens de réinitialisation
FRONTEND_URL=http://localhost:5173

# SMTP — sans ces variables, les liens de réinitialisation sont écrits
# dans les logs au lieu d'être envoyés par e-mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@garmin-dashboard.local

DISCORD_WEBHOOK_URL=
